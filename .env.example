RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=AcuWall <ajanlat@acuwall.hu>
LEAD_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxxxxxxxxxxxxxxxxxx/exec
LEAD_WEBHOOK_SECRET=change-this-secret

# ---------------------------------------------------------------------------
# Hirdetési landing (/ajanlat, ajanlat.acuwall.hu)
# Minden sor opcionális. Üresen hagyva az adott funkció egyszerűen nem indul el.
# ---------------------------------------------------------------------------

# Mérés — a beállítás lépésről lépésre: weboldal_landing/MERES.md
LANDING_GA4_ID=
LANDING_GOOGLE_ADS_ID=
LANDING_GOOGLE_ADS_LABEL=
LANDING_META_PIXEL_ID=

# Közvetlen lead-becsatorna az Octopusba (e-mail helyett/mellett).
# Az Octopus .env-jében a LEADS_WEBHOOK_TOKEN legyen ugyanez az érték.
OCTOPUS_LEAD_URL=
OCTOPUS_LEAD_TOKEN=

# A landing aldomainje. Csak akkor kell átírni, ha nem ajanlat.acuwall.hu.
# Build időben épül be, módosítás után újraépítés szükséges.
LANDING_HOST=ajanlat.acuwall.hu
